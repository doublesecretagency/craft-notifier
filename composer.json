{
    "name": "doublesecretagency/craft-notifier",
    "description": "First-class Notifications for Craft CMS",
    "type": "craft-plugin",
    "version": "3.0.2",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "notify",
        "notifications",
        "notifier",
        "message",
        "email",
        "text",
        "sms"
    ],
    "support": {
        "docs": "https://plugins.doublesecretagency.com/notifier",
        "issues": "https://github.com/doublesecretagency/craft-notifier/issues"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Double Secret Agency",
            "homepage": "https://plugins.doublesecretagency.com"
        }
    ],
    "require": {
        "craftcms/cms": "^4.5.0 || ^5.0.0",
        "league/html-to-markdown": "^5.1",
        "nystudio107/craft-code-editor": "^1.0",
        "nystudio107/craft-twig-sandbox": "^4.0.2 || ^5.0.2",
        "twilio/sdk": "^7.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "doublesecretagency\\notifier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "doublesecretagency\\notifier\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "name": "Notifier",
        "handle": "notifier",
        "class": "doublesecretagency\\notifier\\NotifierPlugin"
    }
}
