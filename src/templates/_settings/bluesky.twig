{% import '_includes/forms' as forms %}
{% set autosuggest = 'notifier/_form/autosuggest' %}

<h2>{{ "Bluesky"|t('notifier') }}</h2>
<p>{{ "Publish posts to your [Bluesky](https://bsky.app) accounts."|t('notifier')|md }}</p>
<p>{{ "Consult the [{name} setup guide]({url}) for complete instructions."|t('notifier', { name: 'Bluesky', url: 'https://plugins.doublesecretagency.com/notifier/getting-started/integrations/bluesky' })|md }}</p>
<p>{{ "Sensitive values can be stored in your `.env` file and referenced here."|t('notifier')|md }}</p>
<div class="pane">
    {% include autosuggest with {
        config: {
            label: "PDS URL"|t('notifier'),
            instructions: "Defaults to https://bsky.social. Point at a custom PDS if your installation federates."|t('notifier'),
            name: 'blueskyPdsUrl',
            placeholder: 'https://bsky.social',
        }
    } %}
</div>

<h2>{{ "Bluesky Accounts"|t('notifier') }}</h2>
<p>{{ "Add the Bluesky accounts you want to post from. Each account becomes available as a recipient on the **Recipients** tab when you set up a notification."|t('notifier')|md }}</p>
<div class="pane notifier-named-list">
    {{ forms.editableTableField({
        label: "Accounts"|t('notifier'),
        instructions: "Click any row's **Test** button to confirm the account authenticates."|t('notifier'),
        id: 'blueskyAccounts',
        name: 'settings[blueskyAccounts]',
        cols: {
            label: {
                heading: "Label"|t('notifier'),
                type: 'singleline',
                width: '20%',
            },
            handle: {
                heading: "Handle"|t('notifier'),
                type: 'singleline',
                width: '30%',
                placeholder: 'example.bsky.social',
            },
            appPassword: {
                heading: "App password"|t('notifier'),
                type: 'singleline',
                width: '30%',
                placeholder: '$BLUESKY_APP_PASSWORD',
            },
            uid: {
                heading: '',
                type: 'hidden',
            },
        },
        rows: settings.blueskyAccounts ?? [],
        addRowLabel: "Add an account"|t('notifier'),
        staticRows: false,
        allowAdd: true,
        allowDelete: true,
        allowReorder: true,
    }) }}
</div>
