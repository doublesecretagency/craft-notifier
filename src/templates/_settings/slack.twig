{% import '_includes/forms' as forms %}

<h2>{{ "Slack"|t('notifier') }}</h2>
<p>{{ "Post messages to your Slack channels."|t('notifier')|md }}</p>
<p>{{ "Consult the [{name} setup guide]({url}) for complete instructions."|t('notifier', { name: 'Slack', url: 'https://plugins.doublesecretagency.com/notifier/getting-started/integrations/slack' })|md }}</p>
<p>{{ "Sensitive values can be stored in your `.env` file and referenced here."|t('notifier')|md }}</p>
<div class="pane notifier-named-list">
    {{ forms.editableTableField({
        label: "Channels"|t('notifier'),
        instructions: "Click any row's **Test** button to send a quick test message to that channel."|t('notifier'),
        id: 'slackChannels',
        name: 'settings[slackChannels]',
        cols: {
            label: {
                heading: "Label"|t('notifier'),
                type: 'singleline',
                width: '25%',
                placeholder: '#channelname',
            },
            botToken: {
                heading: "Bot Token"|t('notifier'),
                type: 'singleline',
                width: '35%',
                placeholder: '$SLACK_BOT_TOKEN',
            },
            channelId: {
                heading: "Channel ID"|t('notifier'),
                type: 'singleline',
                width: '20%',
                placeholder: '$SLACK_CHANNEL_ID',
            },
            uid: {
                heading: '',
                type: 'hidden',
            },
        },
        rows: settings.slackChannels ?? [],
        addRowLabel: "Add a channel"|t('notifier'),
        staticRows: false,
        allowAdd: true,
        allowDelete: true,
        allowReorder: true,
    }) }}
</div>
