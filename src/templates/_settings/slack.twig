{% import '_includes/forms' as forms %}

<h2>{{ "Slack Channels"|t('notifier') }}</h2>
<p>{{ "Create a [Slack app](https://api.slack.com/apps) with the `chat:write`, `chat:write.customize`, and `chat:write.public` scopes, then add a row for each channel you'd like to post into. Each channel becomes available as a recipient on the **Recipients** tab when configuring a notification. A bot token is a secret, so store it in a `.env` variable and reference that variable (e.g. `$SLACK_BOT_TOKEN`) rather than pasting the token directly."|t('notifier')|md }}</p>
<div class="pane notifier-named-list">
    {{ forms.editableTableField({
        label: "Channels"|t('notifier'),
        instructions: "Click any row's **Test** button to send a quick test message to that channel."|t('notifier'),
        id: 'slackChannels',
        name: 'settings[slackChannels]',
        cols: {
            label: {
                heading: "Label"|t('notifier'),
                type: 'singleline',
                width: '25%',
                placeholder: '#channelname',
            },
            botToken: {
                heading: "Bot Token"|t('notifier'),
                type: 'singleline',
                width: '35%',
                placeholder: '$SLACK_BOT_TOKEN',
            },
            channelId: {
                heading: "Channel ID"|t('notifier'),
                type: 'singleline',
                width: '20%',
                placeholder: '$SLACK_CHANNEL_ID',
            },
            uid: {
                heading: '',
                type: 'hidden',
            },
        },
        rows: settings.slackChannels ?? [],
        addRowLabel: "Add a channel"|t('notifier'),
        staticRows: false,
        allowAdd: true,
        allowDelete: true,
        allowReorder: true,
    }) }}
</div>
