{% import '_includes/forms' as forms %}
{% set autosuggest = 'notifier/_form/autosuggest' %}

<h2>{{ "Pushover"|t('notifier') }}</h2>
<p>{{ "Send push notifications through [Pushover](https://pushover.net)."|t('notifier')|md }}</p>
<p>{{ "Consult the [{name} setup guide]({url}) for complete instructions."|t('notifier', { name: 'Pushover', url: 'https://plugins.doublesecretagency.com/notifier/getting-started/integrations/pushover' })|md }}</p>
<p>{{ "Sensitive values can be stored in your `.env` file and referenced here."|t('notifier')|md }}</p>
<div class="pane">
    {% include autosuggest with {
        config: {
            label: "Application API Token"|t('notifier'),
            instructions: "The 30-character app token from your Pushover application."|t('notifier'),
            name: 'pushoverApplicationToken',
        }
    } %}
</div>
