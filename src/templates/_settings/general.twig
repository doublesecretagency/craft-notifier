{% import '_includes/forms' as forms %}
{% set lightswitch = 'notifier/_form/lightswitch' %}
{% set number = 'notifier/_form/number' %}
{% set autosuggest = 'notifier/_form/autosuggest' %}
{% set select = 'notifier/_form/select' %}

{% set loggingOn = (configFile.loggingEnabled ?? settings.loggingEnabled ?? true) ? true : false %}

<h2>{{ "Notification Order"|t('notifier') }}</h2>
<p>{{ "Notifications can be dragged into any order on the index page. Choose where new notifications land in that order."|t('notifier') }}</p>
<div class="pane">
    {% include select with {
        config: {
            label: "Default Placement"|t('notifier'),
            instructions: "Where new notifications are added to the list."|t('notifier'),
            name: 'defaultPlacement',
            options: [
                { label: "Before other notifications"|t('notifier'), value: 'beginning' },
                { label: "After other notifications"|t('notifier'), value: 'end' },
            ],
        }
    } %}
</div>

<h2>{{ "Logging"|t('notifier') }}</h2>
<p>{{ "Notifier keeps a running log of every message it sends. You usually won't need to change this, but you can limit how many log entries are kept in the database."|t('notifier') }}</p>
<div class="pane">
    {% include lightswitch with {
        config: {
            label: "Enable Logging"|t('notifier'),
            instructions: "When disabled, Notifier will not write anything to the notification log."|t('notifier'),
            name: 'loggingEnabled',
            toggle: 'log-retention-fields',
        }
    } %}
    <div id="log-retention-fields" class="log-retention-fields{% if not loggingOn %} hidden{% endif %}">
        {% include number with {
            config: {
                label: "Number of days to retain log events"|t('notifier'),
                instructions: "At most, keep log events for this many days. Leave blank for no limit."|t('notifier'),
                name: 'logRetentionDays',
                min: 1,
            }
        } %}
        {% include number with {
            config: {
                label: "Number of log events to retain"|t('notifier'),
                instructions: "At most, keep this many log events. Leave blank for no limit."|t('notifier'),
                name: 'logRetentionRecords',
                min: 1,
            }
        } %}
    </div>
</div>

<h2>{{ "Scheduled Sending"|t('notifier') }}</h2>
<p>{{ "A shared secret that authenticates scheduled runs triggered over the web. You only need this if you trigger the schedule from the web endpoint."|t('notifier') }}</p>
<div class="pane">
    {% include autosuggest with {
        config: {
            label: "Scheduled-Run Token"|t('notifier'),
            instructions: "Sent with each request as the X-Notifier-Token header or token body parameter."|t('notifier'),
            name: 'scheduledToken',
        }
    } %}
</div>

<style>
    .pane > .field:has(+ .log-retention-fields.hidden) { margin-bottom: 0 !important; }
    .log-retention-fields input[type="number"] { max-width: 8em; }
</style>
