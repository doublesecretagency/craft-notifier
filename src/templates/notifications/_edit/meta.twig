{% import '_includes/forms' as forms %}

{{ forms.textField({
    label: "Title"|t('app'),
    id: 'title',
    name: 'title',
    value: notification.title,
    errors: notification.getErrors('title'),
    first: true,
    autofocus: true,
    required: true,
}) }}

{# Render any admin-attached custom fields, self-namespaced under `fields` #}
{% set fieldLayout = notification.getFieldLayout() %}
{% if fieldLayout and fieldLayout.getCustomFields()|length %}
    <hr>
    {{ fieldLayout.createForm(notification, (readOnly ?? false)).render()|raw }}
{% endif %}
