{% import '_includes/forms' as forms %}

{% set queueInfo = 'Whether the message will be sent immediately, or added to the {link}.'|t('notifier', {
    link: '<a href="https://craftcms.com/docs/5.x/system/queue.html" target="_blank">'~('jobs queue'|t('notifier'))~'</a>',
}) %}

<div class="meta">
    {{ forms.textField({
        label: 'Slug'|t('app'),
        id: 'slug',
        name: 'slug',
        value: notification.slug,
    }) }}
    {{ forms.lightswitchField({
        label: 'Enabled'|t('app'),
        id: 'enabled',
        name: 'enabled',
        on: notification.enabled,
    }) }}
    {{ forms.lightswitchField({
        label: 'Use Queue'|t('notifier'),
        id: 'queue',
        name: 'queue',
        on: (notification.queue ?? true),
        onLabel: 'Queue'|t('notifier'),
        offLabel: 'Immediate'|t('notifier'),
        headingSuffix: '<span class="info">'~queueInfo~'</span>',
    }) }}
    {# Message types which are required to either use or not use the queue #}
    {% for note in [
        {type: 'flash', text: 'Flash messages never use the queue.'|t('notifier')},
        {type: 'announcement', text: 'Announcements always use the queue.'|t('notifier')},
    ] %}
        <div class="notifier-queue-note" data-message-type="{{ note.type }}" style="display: none;">{{ note.text }}</div>
    {% endfor %}
</div>

<dl class="meta read-only">
    <div class="data">
        <dt class="heading">{{ 'ID'|t('app') }}</dt>
        <dd class="value">{{ notification.id }}</dd>
    </div>
    <div class="data">
        <dt class="heading">{{ 'Created at'|t('app') }}</dt>
        <dd class="value">{{ notification.dateCreated|datetime('short') }}</dd>
    </div>
    <div class="data">
        <dt class="heading">{{ 'Updated at'|t('app') }}</dt>
        <dd class="value">{{ notification.dateUpdated|datetime('short') }}</dd>
    </div>
</dl>

