{% import '_includes/forms' as forms %}
{% import 'codeeditor/codeEditor' as codeEditor %}

<div class="message-type-slack hidden">

    <hr>

    {{ codeEditor.textAreaField({
        label: "Slack Message Body"|t('notifier'),
        instructions: "Supports standard [Slack mrkdwn](https://docs.slack.dev/messaging/formatting-message-text/#formatting) syntax. Optionally supports HTML _(see below)_."|t('notifier'),
        tip: templatingTip,
        placeholder: commonPlaceholder,
        rows: 5,
        id: 'messageConfig-slackBody',
        name: 'messageConfig[slackBody]',
        value: (notification.messageConfig.slackBody ?? null),
        errors: notification.getErrors('messageConfig[slackBody]'),
    }, 'CodeEditor', {fixedOverflowWidgets: true}, {wrapperClass: 'monaco-editor-background-frame'}) }}

    {{ forms.lightswitchField({
        label: "Render Message Body as HTML"|t('notifier'),
        instructions: "Whether to only parse as [Slack mrkdwn](https://docs.slack.dev/messaging/formatting-message-text/#formatting), or additionally parse it as HTML."|t('notifier'),
        id: 'messageConfig-slackBodyFormat',
        name: 'messageConfig[slackBodyFormat]',
        offLabel: "mrkdwn only"|t('notifier'),
        onLabel: "mrkdwn + HTML"|t('notifier'),
        on: ((notification.messageConfig.slackBodyFormat ?? 'markdown') == 'html'),
    }) }}

    {{ forms.lightswitchField({
        label: "Render Link Previews"|t('notifier'),
        instructions: "Whether Slack should unfurl link previews for URLs in the message body."|t('notifier'),
        id: 'messageConfig-slackUnfurlLinks',
        name: 'messageConfig[slackUnfurlLinks]',
        offLabel: "Don't unfurl"|t('notifier'),
        onLabel: "Expand link previews"|t('notifier'),
        on: (notification.messageConfig.slackUnfurlLinks ?? true),
    }) }}

    <hr>

    {{ codeEditor.textAreaField({
        label: "Bot Name"|t('notifier'),
        instructions: "Optionally override the app's display name."|t('notifier'),
        tip: templatingTip,
        placeholder: "Dynamic Bot Name"|t('notifier'),
        rows: 1,
        id: 'messageConfig-slackUsername',
        name: 'messageConfig[slackUsername]',
        value: (notification.messageConfig.slackUsername ?? null),
        errors: notification.getErrors('messageConfig[slackUsername]'),
    }, 'CodeEditor', {fixedOverflowWidgets: true}, {wrapperClass: 'monaco-editor-background-frame'}) }}

    {{ codeEditor.textAreaField({
        label: "Bot Icon URL"|t('notifier'),
        instructions: "Optionally override the app's icon with a URL."|t('notifier'),
        tip: templatingTip,
        placeholder: 'https://example.com/icon.png',
        rows: 1,
        id: 'messageConfig-slackIcon',
        name: 'messageConfig[slackIcon]',
        value: (notification.messageConfig.slackIcon ?? null),
        errors: notification.getErrors('messageConfig[slackIcon]'),
    }, 'CodeEditor', {fixedOverflowWidgets: true}, {wrapperClass: 'monaco-editor-background-frame'}) }}

    {{ codeEditor.textAreaField({
        label: "Bot Emoji"|t('notifier'),
        instructions: "Optionally override the app's icon with an emoji. Used only when Bot Icon URL is empty."|t('notifier'),
        tip: templatingTip,
        placeholder: ':rocket:',
        rows: 1,
        id: 'messageConfig-slackEmoji',
        name: 'messageConfig[slackEmoji]',
        value: (notification.messageConfig.slackEmoji ?? null),
        errors: notification.getErrors('messageConfig[slackEmoji]'),
    }, 'CodeEditor', {fixedOverflowWidgets: true}, {wrapperClass: 'monaco-editor-background-frame'}) }}
</div>
