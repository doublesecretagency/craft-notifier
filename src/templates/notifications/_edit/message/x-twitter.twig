{% import '_includes/forms' as forms %}
{% import 'codeeditor/codeEditor' as codeEditor %}

<div class="message-type-x-twitter hidden">

    <hr>

    {{ codeEditor.textAreaField({
        label: "Post Body"|t('notifier'),
        instructions: "Plain text, max 280 characters."|t('notifier'),
        tip: templatingTip,
        placeholder: commonPlaceholder,
        rows: 5,
        id: 'messageConfig-xTwitterBody',
        name: 'messageConfig[xTwitterBody]',
        value: (notification.messageConfig.xTwitterBody ?? null),
        errors: notification.getErrors('messageConfig[xTwitterBody]'),
    }, 'CodeEditor', {fixedOverflowWidgets: true}, {wrapperClass: 'monaco-editor-background-frame'}) }}

    {% include 'notifier/notifications/_edit/message/_media' with { channel: 'xTwitter' } %}
</div>
