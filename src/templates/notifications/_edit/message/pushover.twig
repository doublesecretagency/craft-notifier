{% import '_includes/forms' as forms %}
{% import 'codeeditor/codeEditor' as codeEditor %}

<div class="message-type-pushover hidden">
    {{ forms.selectField({
        label: "Field containing each user's Pushover key"|t('notifier'),
        instructions: "Select which User field contains the recipient's Pushover user key."|t('notifier'),
        id: 'messageConfig-pushoverKeyField',
        name: 'messageConfig[pushoverKeyField]',
        value: (notification.messageConfig.pushoverKeyField ?? null),
        options: notificationOptions.pushoverKeyField,
    }) }}

    <hr>

    {{ codeEditor.textAreaField({
        label: "Pushover Title"|t('notifier'),
        instructions: "Optionally include a heading above the body."|t('notifier'),
        tip: templatingTip,
        placeholder: "Dynamic Pushover Title"|t('notifier'),
        rows: 1,
        id: 'messageConfig-pushoverTitle',
        name: 'messageConfig[pushoverTitle]',
        value: (notification.messageConfig.pushoverTitle ?? null),
        errors: notification.getErrors('messageConfig[pushoverTitle]'),
    }, 'CodeEditor', {fixedOverflowWidgets: true}, {wrapperClass: 'monaco-editor-background-frame'}) }}

    {{ codeEditor.textAreaField({
        label: "Pushover Body"|t('notifier'),
        instructions: "Body of the Pushover notification. Plain text only."|t('notifier'),
        tip: templatingTip,
        placeholder: commonPlaceholder,
        rows: 4,
        id: 'messageConfig-pushoverBody',
        name: 'messageConfig[pushoverBody]',
        value: (notification.messageConfig.pushoverBody ?? null),
        errors: notification.getErrors('messageConfig[pushoverBody]'),
    }, 'CodeEditor', {fixedOverflowWidgets: true}, {wrapperClass: 'monaco-editor-background-frame'}) }}

    <hr>

    {{ forms.lightswitchField({
        label: "Send Message via Queue"|t('notifier'),
        instructions: queueInstructions,
        id: 'messageConfig-pushoverQueue',
        name: 'messageConfig[pushoverQueue]',
        offLabel: "Send immediately"|t('notifier'),
        onLabel: "Add to queue"|t('notifier'),
        on: (notification.messageConfig.pushoverQueue ?? true),
    }) }}
</div>
