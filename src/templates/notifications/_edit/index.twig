{% import '_includes/forms' as forms %}

{% do view.registerAssetBundle('doublesecretagency\\notifier\\web\\assets\\NotificationEditorAsset') %}

{# Keep inline so it loads after the codeeditor asset and wins the cascade, hiding Monaco's right-edge bleed #}
{% css %}
.monaco-editor-background-frame {
    overflow: hidden;
}
{% endcss %}

{% set metaReadOnly       = (metaReadOnly       ?? readOnly ?? false) %}
{% set eventReadOnly      = (eventReadOnly      ?? readOnly ?? false) %}
{% set messageReadOnly    = (messageReadOnly    ?? readOnly ?? false) %}
{% set recipientsReadOnly = (recipientsReadOnly ?? readOnly ?? false) %}

{# Render the hidden inputs outside every fieldset so they always post #}
{{ notification.id ? hiddenInput('elementId', notification.id) }}
{{ notification.siteId ? hiddenInput('siteId', notification.siteId) }}

<div id="meta" class="flex-fields">
    <fieldset class="notifier-edit-fieldset{{ metaReadOnly ? ' notifier-edit-fieldset--readonly' : '' }}"{{ metaReadOnly ? ' disabled' : '' }}>
        {% include 'notifier/notifications/_edit/meta' with { readOnly: metaReadOnly } %}
    </fieldset>
</div>
<div id="event" class="flex-fields hidden">
    <fieldset class="notifier-edit-fieldset{{ eventReadOnly ? ' notifier-edit-fieldset--readonly' : '' }}"{{ eventReadOnly ? ' disabled' : '' }}>
        {% include 'notifier/notifications/_edit/event' with { readOnly: eventReadOnly } %}
    </fieldset>
</div>
<div id="message" class="flex-fields hidden">
    <fieldset class="notifier-edit-fieldset{{ messageReadOnly ? ' notifier-edit-fieldset--readonly' : '' }}"{{ messageReadOnly ? ' disabled' : '' }}>
        {% include 'notifier/notifications/_edit/message' with { readOnly: messageReadOnly } %}
    </fieldset>
</div>
<div id="recipients" class="flex-fields hidden">
    <fieldset class="notifier-edit-fieldset{{ recipientsReadOnly ? ' notifier-edit-fieldset--readonly' : '' }}"{{ recipientsReadOnly ? ' disabled' : '' }}>
        {% include 'notifier/notifications/_edit/recipients' with { readOnly: recipientsReadOnly } %}
    </fieldset>
</div>
