{% import '_includes/forms' as forms %}

{% set channelOptions = [] %}
{% for row in (notificationOptions.slackChannels ?? []) %}
    {% set channelOptions = channelOptions|merge([{ label: row.label, value: row.uid }]) %}
{% endfor %}

<div class="recipients-type-slack-channels">

    {% if channelOptions|length %}
        {{ forms.checkboxSelectField({
            label: "Select Slack channel(s)"|t('notifier'),
            instructions: "Which Slack channels should receive this message?"|t('notifier'),
            id: 'recipientsConfig-slackChannelUids',
            name: 'recipientsConfig[slackChannelUids]',
            options: channelOptions,
            values: (notification.recipientsConfig.slackChannelUids ?? []),
        }) }}
    {% else %}
        <p class="instructions warning">
            {% if craft.app.config.general.allowAdminChanges %}
                {{ "No Slack channels configured. Add one in [Settings → Slack]({url})."|t('notifier', { url: url('settings/plugins/notifier/slack') })|md }}
            {% else %}
                {{ "No Slack channels configured. Channels can only be added in an environment that allows administrative changes."|t('notifier') }}
            {% endif %}
        </p>
    {% endif %}

</div>
