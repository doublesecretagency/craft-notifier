{% js %}
(function () {

    // Get the message type select
    const messageType = document.getElementById('messageType');

    // If select isn't present, bail
    if (!messageType) {
        return;
    }

    // Enable only the recipientsType input matching the current message type
    const sync = function () {

        // Get the current message type value
        const value = messageType.value;

        // Loop through every recipientsType input
        document.querySelectorAll('[name="recipientsType"]').forEach(function (input) {

            // Find the input's message-type wrapper
            const wrapper = input.closest('[class*="message-type-"]');

            // If no wrapper, disable and bail
            if (!wrapper) {
                input.disabled = true;
                return;
            }

            // Extract message types declared on the wrapper
            const types = Array.from(wrapper.classList)
                .filter(function (c) { return c.startsWith('message-type-'); })
                .map(function (c) { return c.substring('message-type-'.length); });

            // Disable unless the wrapper covers the current message type
            input.disabled = !value || !types.includes(value);
        });
    };

    // Re-sync on every message type change
    messageType.addEventListener('change', sync);

    // Sync once on initial load
    sync();

})();
{% endjs %}
