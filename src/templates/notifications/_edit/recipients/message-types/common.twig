{% import '_includes/forms' as forms %}

{# Gate the Dynamic Recipients option by the dedicated permission #}
{% set canEditDynamicRecipients = currentUser.can('notifier-editDynamicRecipients') %}

{# Build the dropdown options, omitting Dynamic Recipients for users lacking the permission #}
{% set recipientsTypeOptions = notificationOptions.recipientsType %}
{% if not canEditDynamicRecipients %}
    {% set recipientsTypeOptions = recipientsTypeOptions|filter((label, value) => value != 'dynamic-recipients') %}
{% endif %}

{# Filter down to the User-centric recipient types for the email / sms / announcement / pushover wrapper #}
{% set userCentricKeys = ['current-user', 'all-users', 'all-admins', 'selected-groups', 'selected-users', 'dynamic-recipients'] %}
{% set userCentricOptions = recipientsTypeOptions|filter((label, value) => value in userCentricKeys) %}

<div class="message-type-email message-type-sms message-type-announcement message-type-pushover hidden">
    {{ forms.selectField({
        label: 'Recipients Type'|t('notifier'),
        instructions: 'Who will receive this message?'|t('notifier'),
        id: 'recipientsType',
        name: 'recipientsType',
        value: notification.recipientsType,
        options: {'':''}|merge(userCentricOptions),
        toggle: true,
        targetPrefix: '.recipients-type-',
    }) }}
    {% include 'notifier/notifications/_edit/recipients/current-user' %}
    {% include 'notifier/notifications/_edit/recipients/all-users' %}
    {% include 'notifier/notifications/_edit/recipients/all-admins' %}
    {% include 'notifier/notifications/_edit/recipients/selected-groups' %}
    {% include 'notifier/notifications/_edit/recipients/selected-users' %}
    {% if canEditDynamicRecipients %}
        {% include 'notifier/notifications/_edit/recipients/dynamic-recipients' %}
    {% endif %}
</div>

{# ntfy: locked to ntfy-topics #}
<div class="message-type-ntfy hidden">
    <input type="hidden" name="recipientsType" value="ntfy-topics" disabled>
    {% include 'notifier/notifications/_edit/recipients/ntfy-topics' %}
</div>

