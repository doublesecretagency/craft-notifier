{% import 'codeeditor/codeEditor' as codeEditor %}

{# Placeholder snippet #}
{% set placeholder %}{%- verbatim -%}<pre>
{% setRecipients entry.author %}
</pre>{%- endverbatim -%}{% endset %}

{% set instructions %}
{{ 'Enter a custom Twig snippet to [determine who will receive the message]({url}).'|t('notifier', {url: 'https://plugins.doublesecretagency.com/notifier/recipients/types/dynamic-recipients'})|md }}
{{ 'The snippet **must** include a `{% setRecipients %}` tag.'|t('notifier')|md }}
{% endset %}

<div class="recipients-type-dynamic-recipients hidden">
    {{ codeEditor.textAreaField({
        label: "Twig Snippet to Determine Recipients"|t('notifier'),
        instructions: instructions,
        tip: templatingTip,
        placeholder: placeholder,
        id: 'config-recipients-dynamic-recipients',
        name: 'recipientsConfig[dynamicRecipients]',
        value: (notification.recipientsConfig.dynamicRecipients ?? ''),
        rows: 4,
    }, 'CodeEditor', {fixedOverflowWidgets: true}, {wrapperClass: 'monaco-editor-background-frame'}) }}
</div>
