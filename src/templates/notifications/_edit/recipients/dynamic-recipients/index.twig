{% import 'codeeditor/codeEditor' as codeEditor %}

{# Load field info #}
{% set placeholder = include('notifier/notifications/_edit/recipients/dynamic-recipients/placeholder') %}

{% set instructions %}
Enter a custom Twig snippet to determine who will receive the message.

{{ 'The snippet **must** include a `{% setRecipients %}` tag to specify the message recipients.'|md }}
{% endset %}

<div class="recipients-type-dynamic-recipients hidden">
    {{ codeEditor.textAreaField({
        label: "Twig Snippet to Determine Recipients"|t('notifier'),
        instructions: instructions|t('notifier'),
        tip: templatingTip,
        placeholder: placeholder,
        id: 'config-recipients-dynamic-recipients',
        name: 'recipientsConfig[dynamicRecipients]',
        value: (notification.recipientsConfig.dynamicRecipients ?? ''),
        rows: 4,
    }, 'CodeEditor', {fixedOverflowWidgets: true}, {wrapperClass: 'monaco-editor-background-frame'}) }}

    <div class="readable">
        <blockquote class="note tip">
            See the complete documentation for <a href="https://plugins.doublesecretagency.com/notifier/recipients/types/dynamic-recipients" target="_blank">Dynamic Recipients...</a>
        </blockquote>
    </div>
</div>
