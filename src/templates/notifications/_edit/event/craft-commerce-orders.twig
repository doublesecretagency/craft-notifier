{% import '_includes/forms' as forms %}

<div class="event-type-craft-commerce-orders hidden">
    {{ forms.selectField({
        label: 'Commerce Orders Event'|t('notifier'),
        instructions: commonInstructions,
        id: 'event-craft-commerce-orders',
        name: 'event[craft-commerce-orders]',
        value: notification.event,
        options: {'':''}|merge(notificationOptions.allEvents['craft-commerce-orders'] ?? []),
        toggle: true,
        targetPrefix: '.craft-commerce-orders-event-',
    }) }}
    <div class="craft-commerce-orders-event-manually-triggered hidden">
        {% include 'notifier/notifications/_edit/event/_manual-trigger-label' with { eventType: 'craft-commerce-orders' } %}
    </div>
    <div class="craft-commerce-orders-event-date-reached hidden">
        {% include 'notifier/notifications/_edit/event/_date-reached' with { eventType: 'craft-commerce-orders' } %}
    </div>
    {# Hidden until a Commerce Orders Event is selected #}
    <div class="craft-commerce-orders-event-manually-triggered craft-commerce-orders-event-date-reached craft-commerce-orders-event-after-complete-order craft-commerce-orders-event-after-order-paid hidden">
        {% include 'notifier/notifications/_edit/event/_condition' with { eventType: 'craft-commerce-orders' } %}
    </div>
</div>
