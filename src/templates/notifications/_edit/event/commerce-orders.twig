{% import '_includes/forms' as forms %}

<div class="event-type-commerce-orders hidden">
    {{ forms.selectField({
        label: 'Commerce Orders Event'|t('notifier'),
        instructions: commonInstructions,
        id: 'event-commerce-orders',
        name: 'event[commerce-orders]',
        value: notification.event,
        options: {'':''}|merge(notificationOptions.allEvents['commerce-orders'] ?? []),
        toggle: true,
        targetPrefix: '.commerce-orders-event-',
    }) }}
    {# Hidden until a Commerce Orders Event is selected #}
    <div class="commerce-orders-event-after-complete-order commerce-orders-event-after-order-paid hidden">
        {% include 'notifier/notifications/_edit/event/_condition' with { eventType: 'commerce-orders' } %}
    </div>
</div>
