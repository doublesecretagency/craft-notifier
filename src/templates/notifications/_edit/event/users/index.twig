{% import '_includes/forms' as forms %}

<div class="event-type-users hidden">
    {{ forms.selectField({
        label: 'Users Event'|t('notifier'),
        instructions: commonInstructions,
        id: 'event-users',
        name: 'event[users]',
        value: notification.event,
        options: {'':''}|merge(notificationOptions.allEvents['users']),
        toggle: true,
        targetPrefix: '.users-event-',
    }) }}
    <div class="users-event-manually-triggered hidden">
        {% include 'notifier/notifications/_edit/event/_manual-trigger-label' with { eventType: 'users' } %}
    </div>
    <hr class="users-event-manually-triggered users-event-after-propagate users-event-after-activate-user users-event-after-update users-event-after-assign-to-groups users-event-after-delete users-event-after-restore hidden">
    {% include 'notifier/notifications/_edit/event/users/groups' %}
    {% include 'notifier/notifications/_edit/event/users/condition' %}
</div>
