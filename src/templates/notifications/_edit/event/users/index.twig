        label: 'Users Event'|t('notifier'),
        instructions: commonInstructions,
        id: 'event-users',
        name: 'event[users]',
        value: notification.event,
        options: {'':''}|merge(notificationOptions.allEvents['users']),
        toggle: true,
        targetPrefix: '.users-event-',
