{% import '_includes/forms' as forms %}

<div class="event-type-entries hidden">
    {{ forms.selectField({
        label: 'Entries Event'|t('notifier'),
        instructions: commonInstructions,
        id: 'event-entries',
        name: 'event[entries]',
        value: notification.event,
        options: {'':''}|merge(notificationOptions.allEvents['entries']),
        toggle: true,
        targetPrefix: '.entries-event-',
    }) }}
    <div class="entries-event-manually-triggered hidden">
        {% include 'notifier/notifications/_edit/event/_manual-trigger-label' with { eventType: 'entries' } %}
    </div>
    <div class="entries-event-date-reached hidden">
        {% include 'notifier/notifications/_edit/event/_date-reached' with { eventType: 'entries' } %}
    </div>
    <hr class="entries-event-manually-triggered entries-event-after-save entries-event-after-propagate entries-event-after-delete entries-event-after-restore hidden">
    {% include 'notifier/notifications/_edit/event/entries/sites' %}
    {% include 'notifier/notifications/_edit/event/entries/entry-types' %}
    {% include 'notifier/notifications/_edit/event/entries/filters' %}
    {% include 'notifier/notifications/_edit/event/entries/condition' %}
</div>
