{% import '_includes/forms' as forms %}

<div class="event-type-assets hidden">
    {{ forms.selectField({
        label: 'Assets Event'|t('notifier'),
        instructions: commonInstructions,
        id: 'event-assets',
        name: 'event[assets]',
        value: notification.event,
        options: {'':''}|merge(notificationOptions.allEvents['assets']),
        toggle: true,
        targetPrefix: '.assets-event-',
    }) }}
    <div class="assets-event-manually-triggered hidden">
        {% include 'notifier/notifications/_edit/event/_manual-trigger-label' with { eventType: 'assets' } %}
    </div>
    <div class="assets-event-date-reached hidden">
        {% include 'notifier/notifications/_edit/event/_date-reached' with { eventType: 'assets' } %}
    </div>
    <hr class="assets-event-manually-triggered assets-event-date-reached assets-event-after-propagate assets-event-after-move assets-event-after-update assets-event-after-delete assets-event-after-restore hidden">
    {% include 'notifier/notifications/_edit/event/assets/volumes' %}
    {% include 'notifier/notifications/_edit/event/assets/condition' %}
</div>
