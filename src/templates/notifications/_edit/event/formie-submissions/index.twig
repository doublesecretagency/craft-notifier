{% import '_includes/forms' as forms %}

<div class="event-type-formie-submissions hidden">
    {% include 'notifier/notifications/_edit/event/formie-submissions/forms' %}
    {{ forms.selectField({
        label: 'Submission Outcome'|t('notifier'),
        instructions: 'Trigger based on the success or failure of a submission.'|t('notifier'),
        id: 'eventConfig-submissionOutcome',
        name: 'eventConfig[submissionOutcome]',
        value: notification.eventConfig.submissionOutcome ?? 'success',
        options: {
            success: 'Successful submissions only'|t('notifier'),
            failure: 'Failed submissions only'|t('notifier'),
            all: 'All submissions'|t('notifier'),
        },
    }) }}
    {% include 'notifier/notifications/_edit/event/formie-submissions/condition' %}
    {# Hard-coded event since Formie only has one trigger, and included last for CSS reasons #}
    <input type="hidden" name="event[formie-submissions]" value="after-submission">
</div>

{# The forms picker has no divider above it, so pull it up to close the gap nested-checkboxes.css leaves #}
{% css %}
    .event-type-formie-submissions .nested-checkboxes-forms {
        margin-top: -15px;
    }
{% endcss %}
