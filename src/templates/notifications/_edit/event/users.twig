{% import '_includes/forms' as forms %}

<div class="event-type-users hidden">
    {{ forms.selectField({
        label: 'Users Event'|t('notifier'),
        instructions: commonInstructions,
        id: 'event-users',
        name: 'event[users]',
        value: notification.event,
        options: {'':''}|merge(notificationOptions.allEvents['users']),
        toggle: true,
        targetPrefix: '.users-event-',
    }) }}
    {# Hidden until a Users Event is selected #}
    <div class="users-event-after-propagate users-event-after-activate-user hidden">
        {% include 'notifier/notifications/_edit/event/_condition' with { eventType: 'users' } %}
    </div>
</div>
