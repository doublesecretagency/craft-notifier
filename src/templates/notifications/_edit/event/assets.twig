{% import '_includes/forms' as forms %}

<div class="event-type-assets hidden">
    {{ forms.selectField({
        label: 'Assets Event'|t('notifier'),
        instructions: commonInstructions,
        id: 'event-assets',
        name: 'event[assets]',
        value: notification.event,
        options: {'':''}|merge(notificationOptions.allEvents['assets']),
        toggle: true,
        targetPrefix: '.assets-event-',
    }) }}
    {# Hidden until an Assets Event is selected #}
    <div class="assets-event-after-propagate hidden">
        {% include 'notifier/notifications/_edit/event/_condition' with { eventType: 'assets' } %}
    </div>
</div>
