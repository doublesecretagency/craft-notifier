{# Render the test-send button into the CP screen's additional-buttons slot #}
{% if notification.id and not notification.isUnpublishedDraft and currentUser.can('notifier-testNotifications') %}
    {% do view.registerAssetBundle('doublesecretagency\\notifier\\web\\assets\\TestNotificationAsset') %}
    <button type="button" class="btn"
            data-notifier-test-id="{{ notification.id }}"
            data-notifier-test-confirm="{{ 'Send a REAL test notification?\n\n⚠️ Uses a random sample of real data.\n⚠️ Sends a real message via the configured channel.\n⚠️ Delivers to the real configured recipient(s).'|t('notifier') }}">
        {{ 'Send a test message'|t('notifier') }}
    </button>
{% endif %}
